# OIDC authentication example
# See docs/guides/authentication.md for setup instructions

KROKI_MCP_BASE_URL=https://mcp.example.com
KROKI_MCP_OIDC_CONFIG_URL=https://auth.example.com/.well-known/openid-configuration
KROKI_MCP_OIDC_CLIENT_ID=mcp-client
KROKI_MCP_OIDC_CLIENT_SECRET=your-client-secret
KROKI_MCP_OIDC_JWT_SIGNING_KEY=your-signing-key   # openssl rand -hex 32
KROKI_MCP_READ_ONLY=false
